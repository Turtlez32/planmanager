# MCP authentication tokens — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAUDE_MCP_TOKEN=
CODEX_MCP_TOKEN=
ADMIN_MCP_TOKEN=

# Public base URL of the deployed service
BASE_URL=https://plans.turtlez.au

# Injected automatically by Vercel when Postgres (Neon) is connected to the project
POSTGRES_URL=

# Injected automatically by Vercel when Blob storage is connected to the project
BLOB_READ_WRITE_TOKEN=
